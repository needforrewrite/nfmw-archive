  "db_name": "PostgreSQL",
  "query": "\n            INSERT INTO user_sessions (user_id, token, auth_provider)\n            VALUES ($1, $2, $3)\n            ON CONFLICT (user_id) DO UPDATE SET\n                token = EXCLUDED.token,\n                auth_provider = EXCLUDED.auth_provider,\n                created_at = now(),\n                last_seen_at = now(),\n                expires_at = now() + INTERVAL '30 days'\n            RETURNING *\n            ",
